# Application mode: demo | production-like (demo enables simulation clock controls)
APP_MODE=demo
APP_TIMEZONE=Asia/Singapore

# Repair problem catalog (the ONLY business source for trade / problem / complexity / duration)
REPAIR_CATALOG_PATH=data/reference/repair_object_problem_database.csv

# SQLite database (relative to repo root)
DATABASE_URL=sqlite:///./data/app.db

# LLM: mock (rule-based, offline) | real
LLM_MODE=mock
# real → provider: anthropic (Anthropic SDK, LLM_MODEL default claude-opus-5)
#              or openai_compat (any OpenAI-style /v1/chat/completions endpoint, e.g. DeepSeek via ModelScope:
#                 LLM_BASE_URL=https://api-inference.modelscope.cn/v1  LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Routing: fixture (offline 18-point matrix, presets only) | osrm (real road network, any coordinate) | estimated (haversine)
ROUTE_MODE=fixture
# osrm: public demo https://router.project-osrm.org (light use only) or your own server http://localhost:5000 (README → Routing)
OSRM_BASE_URL=
# OSRM returns free-flow driving time (no live traffic): travel = ceil(minutes * factor) + base_minutes (parking/access)
OSRM_DURATION_FACTOR=1.25
OSRM_BASE_MINUTES=3

# Geocoding of typed addresses (customer chat): auto | onemap | nominatim | none
#   auto     = OneMap when credentials are set (register free at https://www.onemap.gov.sg/apidocs/register), else Nominatim
#   OneMap   = authoritative Singapore postal codes / HDB blocks (needs ONEMAP_EMAIL+ONEMAP_PASSWORD, token auto-fetched, or ONEMAP_TOKEN)
#   Nominatim= OpenStreetMap, no key, ≤1 req/s, good for streets/landmarks, weaker for block numbers; results are cached on disk
GEOCODE_MODE=auto
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_TOKEN=

# Background loop: real seconds between risk scans; sim minutes advanced per real second when clock running
RISK_SCAN_INTERVAL_SECONDS=60
CLOCK_RUN_SIM_MINUTES_PER_SECOND=1

# V3 knobs are policy, not environment: config/policy.yaml → breaks (dynamic rest thresholds), agent (tool/search budgets),
# emergency_channels (verified numbers + sources), duration_prediction (mode: shadow = predictions recorded next to the
# CSV baseline, never used for scheduling).
